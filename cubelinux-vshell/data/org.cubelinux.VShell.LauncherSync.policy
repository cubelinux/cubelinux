<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>cubeLinux</vendor>
  <action id="org.cubelinux.VShell.LauncherSync">
    <description>Update Fedora application menu entries</description>
    <message>Authentication is required to update Fedora application menu entries</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/cubelinux-vshell-launcher-sync</annotate>
  </action>
</policyconfig>
