<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD polkit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Vireak OS</vendor>
  <action id="org.cubelinux.VShell.LxcSetup">
    <description>Set up Virtual Shell networking</description>
    <message>Authentication is required to enable rootless LXC for your account</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/cubelinux-vshell-host-setup</annotate>
  </action>
</policyconfig>
