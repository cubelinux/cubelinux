#!/bin/sh

if [ "$#" -ne 1 ]; then
    exit 2
fi

case "$1" in
    check)
        /usr/bin/bootc upgrade --check
        result=$?
        if [ "$result" -ne 0 ]; then
            exit "$result"
        fi
        printf '\nBOOTC_UPDATER_STATUS_JSON_BEGIN\n'
        /usr/bin/bootc status --format=json || true
        ;;
    download)
        exec /usr/bin/bootc upgrade --download-only --progress-fd=1
        ;;
    apply)
        exec /usr/bin/bootc upgrade --from-downloaded --apply
        ;;
    *)
        exit 2
        ;;
esac
