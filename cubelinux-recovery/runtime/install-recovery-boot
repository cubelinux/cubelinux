#!/usr/bin/bash
set -euo pipefail

target=${1:?Usage: install-recovery-boot TARGET_ROOT}
target=$(/usr/bin/realpath -e -- "$target")
fail() { echo "Recovery boot setup failed: $*" >&2; exit 1; }
[[ -d /sys/firmware/efi/efivars ]] || fail 'UEFI variables are unavailable'
if [[ "$target" == / ]]; then
    efi_mount=/boot/efi
else
    efi_mount="$target/boot/efi"
fi
efi=$(/usr/bin/findmnt --raw --noheadings --output SOURCE --mountpoint "$efi_mount") || fail 'EFI partition is not mounted'
efi=${efi%%\[*}
[[ -b "$efi" ]] || fail 'EFI source is not a block device'
disk=$(/usr/bin/lsblk --inverse --list --noheadings --paths --output NAME,TYPE -- "$efi" | /usr/bin/awk '$2 == "disk" {print $1; exit}')
part=$(/usr/bin/lsblk --nodeps --noheadings --output PARTN -- "$efi" | /usr/bin/tr -d '[:space:]')
efi_id=$(/usr/sbin/blkid -s PARTUUID -o value "$efi")
[[ -n "$disk" && "$part" =~ ^[0-9]+$ && "$efi_id" =~ ^[[:xdigit:]-]{36}$ ]] || fail 'could not identify EFI partition'
[[ $(/usr/sbin/blkid -s TYPE -o value "$efi") == vfat ]] || fail 'EFI partition is not FAT formatted'
if [[ "$target" == / ]]; then
    if root=$(/usr/bin/findmnt --raw --noheadings --output SOURCE --mountpoint /sysroot 2>/dev/null); then
        :
    else
        root=$(/usr/bin/findmnt --raw --noheadings --output SOURCE --mountpoint /) || fail 'root is not mounted'
    fi
else
    root=$(/usr/bin/findmnt --raw --noheadings --output SOURCE --mountpoint "$target") || fail 'root is not mounted'
fi
root=${root%%\[*}
root_part=$(/usr/bin/lsblk --inverse --list --noheadings --paths --output NAME,TYPE -- "$root" | /usr/bin/awk '$2 == "part" {print $1; exit}')
root_disk=$(/usr/bin/lsblk --inverse --list --noheadings --paths --output NAME,TYPE -- "$root" | /usr/bin/awk '$2 == "disk" {print $1; exit}')
[[ -n "$root_part" && "$root_disk" == "$disk" ]] || fail 'the EFI and root partitions must be on the same disk'
root_id=$(/usr/sbin/blkid -s PARTUUID -o value "$root_part")
disk_id=$(/usr/sbin/blkid -s PTUUID -o value "$disk")
[[ "$disk_id" =~ ^[[:xdigit:]-]{36}$ ]] ||
    fail 'the EFI and root partitions must be on the same GPT disk'
mapfile -t candidates < <(/usr/sbin/blkid -t PARTLABEL=CUBE_RECOVERY -o device || true)
matches=()
for candidate in "${candidates[@]}"; do
    [[ -b "$candidate" ]] || continue
    candidate_disk=$(/usr/bin/lsblk --inverse --list --noheadings --paths --output NAME,TYPE -- "$candidate" | /usr/bin/awk '$2 == "disk" {print $1; exit}')
    [[ "$candidate_disk" == "$disk" ]] || continue
    [[ $(/usr/sbin/blkid -s TYPE -o value "$candidate") == ext4 ]] || continue
    # The staging job wrote the root and EFI identities to this partition.
    tmp=$(/usr/bin/mktemp -d /run/cubelinux-boot-check.XXXXXX)
    if /usr/bin/mount -o ro,nodev,nosuid,noexec "$candidate" "$tmp"; then
        selector="$tmp/active.cfg"
        mapfile -t selectors < <(/usr/bin/sed -n 's/^set recovery_slot=//p' "$selector")
        if (( ${#selectors[@]} == 1 )) && [[ "${selectors[0]}" == A || "${selectors[0]}" == B ]]; then
            slot=${selectors[0]}
            manifest="$tmp/slots/$slot/CUBELINUX_LAYOUT"
            recovery_id=$(/usr/sbin/blkid -s PARTUUID -o value "$candidate")
            expected_config=$(printf 'set recovery_slot=%s\nlinux ($recovery)/slots/%s/boot/vmlinuz root=live:PARTUUID=%s ro rd.live.image rd.live.dir=/slots/%s/LiveOS rd.live.overlay.overlayfs=1 cubelinux.recovery=1 cubelinux.recovery_slot=%s console=tty0\ninitrd ($recovery)/slots/%s/boot/initrd.img\nboot\n' \
                "$slot" "$slot" "$recovery_id" "$slot" "$slot" "$slot")
            if [[ -f "$manifest" && "$(<"$selector")" == "$expected_config" ]] && \
                /usr/bin/grep -Fxq "disk_ptuuid=$disk_id" "$manifest" && \
                /usr/bin/grep -Fxq "root_partuuid=$root_id" "$manifest" && \
                /usr/bin/grep -Fxq "recovery_partuuid=$recovery_id" "$manifest" && \
                /usr/bin/grep -Fxq "efi_partuuid=$efi_id" "$manifest"; then
                matches+=("$candidate")
            fi
        fi
        /usr/bin/umount "$tmp" || fail 'could not unmount recovery check'
    fi
    /usr/bin/rmdir "$tmp"
done
(( ${#matches[@]} == 1 )) || fail "expected one matching recovery partition, found ${#matches[@]}"
recovery_id=$(/usr/sbin/blkid -s PARTUUID -o value "${matches[0]}")
recovery_fs_uuid=$(/usr/sbin/blkid -s UUID -o value "${matches[0]}")
[[ "$recovery_id" =~ ^[[:xdigit:]-]{36}$ ]] || fail 'invalid recovery partition identity'
[[ "$recovery_fs_uuid" =~ ^[[:xdigit:]-]{36}$ ]] || fail 'invalid recovery filesystem identity'

boot_dir="$efi_mount/EFI/cubelinux-recovery"
boot_metadata="$boot_dir/boot-layout"
fedora_boot_dir="$efi_mount/EFI/fedora"
shim_source="$fedora_boot_dir/shimx64.efi"
grub_source="$fedora_boot_dir/grubx64.efi"
[[ -s "$shim_source" ]] || fail 'the Fedora Secure Boot shim is missing from the EFI partition'
[[ -s "$grub_source" ]] || fail 'the Fedora-signed GRUB loader is missing from the EFI partition'

# Reuse the Fedora-signed shim and GRUB unchanged. A custom grub2-mkstandalone
# image is not trusted by Secure Boot and must never be the firmware entry.
tmp=$(/usr/bin/mktemp -d /run/cubelinux-signed-grub.XXXXXX)
order_to_restore=
restore_order=0
cleanup() {
    if (( restore_order )) && [[ -n "$order_to_restore" ]]; then
        /usr/sbin/efibootmgr --bootorder "$order_to_restore" >&2 || true
    fi
    /usr/bin/rm -rf -- "$tmp"
}
trap cleanup EXIT

staged_boot="$tmp/EFI/cubelinux-recovery"
/usr/bin/install -d -m 0755 "$staged_boot"
/usr/bin/install -m 0644 "$shim_source" "$staged_boot/shimx64.efi"
/usr/bin/install -m 0644 "$grub_source" "$staged_boot/grubx64.efi"
cat > "$staged_boot/grub.cfg" <<EOF
search --no-floppy --fs-uuid --set=recovery $recovery_fs_uuid
export recovery
configfile (\$recovery)/active.cfg
EOF
shim_sha=$(/usr/bin/sha256sum "$staged_boot/shimx64.efi")
grub_sha=$(/usr/bin/sha256sum "$staged_boot/grubx64.efi")
config_sha=$(/usr/bin/sha256sum "$staged_boot/grub.cfg")
{
    printf 'format=2\n'
    printf 'recovery_partuuid=%s\n' "$recovery_id"
    printf 'recovery_fs_uuid=%s\n' "$recovery_fs_uuid"
    printf 'efi_partuuid=%s\n' "$efi_id"
    printf 'shim_sha256=%s\n' "${shim_sha%% *}"
    printf 'grub_sha256=%s\n' "${grub_sha%% *}"
    printf 'grub_cfg_sha256=%s\n' "${config_sha%% *}"
} > "$staged_boot/boot-layout"

/usr/bin/install -d -m 0755 "$boot_dir"
for name in shimx64.efi grubx64.efi grub.cfg; do
    /usr/bin/install -m 0644 "$staged_boot/$name" "$boot_dir/.$name.new"
    /usr/bin/mv -f "$boot_dir/.$name.new" "$boot_dir/$name"
done
/usr/bin/install -m 0644 "$staged_boot/boot-layout" "$boot_dir/.boot-layout.new"
/usr/bin/mv -f "$boot_dir/.boot-layout.new" "$boot_metadata"
/usr/bin/sync --file-system "$efi_mount"

# Preserve the ordinary OS boot order and migrate the old unsigned entry.
before=$(/usr/sbin/efibootmgr -v)
order=$(printf '%s\n' "$before" | /usr/bin/sed -n 's/^BootOrder: //p')
[[ -n "$order" ]] || fail 'firmware boot order is unavailable'
order_to_restore=$order
restore_order=1
mapfile -t recovery_entries < <(printf '%s\n' "$before" | /usr/bin/awk \
    -v id="${efi_id,,}" 'tolower($0) ~ id && /cubelinux recovery/ { print substr($1,5,4) }')
(( ${#recovery_entries[@]} <= 1 )) || fail 'multiple recovery firmware entries are present'

expected_loader='file(\efi\cubelinux-recovery\shimx64.efi)'
existing=${recovery_entries[0]:-}
if [[ -n "$existing" ]]; then
    existing_line=$(printf '%s\n' "$before" | /usr/bin/awk -v boot="Boot$existing" 'substr($1,1,8) == boot { print }')
    if [[ "${existing_line,,}" != *"$expected_loader"* ]]; then
        /usr/sbin/efibootmgr --bootnum "$existing" --delete-bootnum
        order_to_restore=$(printf '%s' "$order" | /usr/bin/tr ',' '\n' |
            /usr/bin/grep -Fvx "$existing" | /usr/bin/paste -sd, -)
        [[ -n "$order_to_restore" ]] || fail 'firmware boot order would be empty after replacing the old recovery entry'
        existing=
    fi
fi

if [[ -z "$existing" ]]; then
    /usr/sbin/efibootmgr --create --disk "$disk" --part "$part" \
        --label 'cubelinux recovery' --loader '\EFI\cubelinux-recovery\shimx64.efi'
    after=$(/usr/sbin/efibootmgr -v)
    mapfile -t created_candidates < <(printf '%s\n' "$after" | /usr/bin/awk \
        -v id="${efi_id,,}" 'tolower($0) ~ id && /cubelinux recovery/ { print substr($1,5,4) }')
    created_entries=()
    for candidate in "${created_candidates[@]}"; do
        candidate_line=$(printf '%s\n' "$after" | /usr/bin/awk \
            -v boot="Boot$candidate" 'substr($1,1,8) == boot { print }')
        [[ "${candidate_line,,}" == *"$expected_loader"* ]] && created_entries+=("$candidate")
    done
    (( ${#created_entries[@]} == 1 )) || fail 'signed recovery firmware entry is missing or ambiguous'
    existing=${created_entries[0]}
fi

[[ "$existing" =~ ^[[:xdigit:]]{4}$ ]] || fail 'recovery firmware entry is invalid'
case ",$order_to_restore," in
    *",$existing,"*) ;;
    *) order_to_restore="${order_to_restore:+$order_to_restore,}$existing" ;;
esac
/usr/sbin/efibootmgr --bootorder "$order_to_restore"
restore_order=0
echo "Installed Fedora-signed recovery boot entry $existing."
