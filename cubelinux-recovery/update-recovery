#!/usr/bin/python3
"""Update the inactive recovery slot from the currently booted bootc image."""

import fcntl
from contextlib import contextmanager
import hashlib
import json
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import stat
import subprocess
import sys
import tempfile

MAX_BUNDLE = 14 * 1024**3
REQUIRED_FILES = ("LiveOS/squashfs.img", "boot/vmlinuz", "boot/initrd.img",
                  "CUBELINUX_IMAGE_REF", "CUBELINUX_LAYOUT")
SCRATCH_MARKER = "cubelinux-recovery-update-v1\n"


def command(*args: str) -> str:
    return subprocess.run(args, check=True, text=True, stdout=subprocess.PIPE).stdout.strip()


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def parse_layout(path: Path) -> dict[str, str]:
    result = {}
    for line in path.read_text().splitlines():
        key, separator, value = line.partition("=")
        if not separator or key in result or not value:
            raise ValueError("invalid recovery layout")
        result[key] = value
    if set(result) != {"format", "disk_ptuuid", "root_partuuid", "recovery_partuuid", "efi_partuuid"} or result["format"] != "1":
        raise ValueError("unsupported recovery layout")
    if any(not re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", result[key])
           for key in result if key != "format"):
        raise ValueError("invalid partition identifier")
    return result


def verify_slot(slot: Path) -> dict[str, str]:
    entries = {}
    for line in (slot / "SHA256SUMS").read_text().splitlines():
        match = re.fullmatch(r"([0-9a-f]{64})  (.+)", line)
        if not match or match.group(2) in entries:
            raise ValueError("invalid recovery checksum manifest")
        entries[match.group(2)] = match.group(1)
    expected_names = set(REQUIRED_FILES)
    if (slot / "CUBELINUX_DIGEST").exists() or (slot / "CUBELINUX_DIGEST").is_symlink():
        expected_names.add("CUBELINUX_DIGEST")
    if set(entries) != expected_names:
        raise ValueError("unexpected recovery checksum entries")
    for name, expected in entries.items():
        path = slot / name
        if not path.is_file() or path.is_symlink() or sha256(path) != expected:
            raise ValueError(f"recovery checksum failed: {name}")
    return parse_layout(slot / "CUBELINUX_LAYOUT")


def device_info(device: str) -> tuple[str, str]:
    lines = command("/usr/bin/lsblk", "--inverse", "--list", "--noheadings", "--paths",
                    "--output", "NAME,TYPE", "--", device).splitlines()
    values = [line.split() for line in lines]
    part = next((name for name, kind in values if kind == "part"), "")
    disk = next((name for name, kind in values if kind == "disk"), "")
    if not part or not disk:
        raise ValueError("cannot identify the installed system disk")
    return part, disk


def block_id(device: str, tag: str) -> str:
    return command("/usr/sbin/blkid", "-s", tag, "-o", "value", device)


def active_slot(mount: Path) -> str:
    lines = (mount / "active.cfg").read_text().splitlines()
    values = [line.removeprefix("set recovery_slot=") for line in lines
              if line.startswith("set recovery_slot=")]
    if len(values) != 1 or values[0] not in ("A", "B"):
        raise ValueError("invalid recovery slot selector")
    return values[0]


def booted_image() -> tuple[str, str, str]:
    state = json.loads(command("/usr/bin/bootc", "status", "--format=json", "--format-version=1"))
    image = state["status"]["booted"]["image"]
    reference = image["image"]["image"]
    digest = image["imageDigest"]
    if image["image"].get("transport") != "registry" or not re.fullmatch(r"sha256:[0-9a-f]{64}", digest):
        raise ValueError("booted image does not have a usable registry digest")
    name = reference.split("@", 1)[0]
    prefix, separator, tail = name.rpartition("/")
    tail = tail.split(":", 1)[0]
    repository = prefix + separator + tail
    if not repository or any(c.isspace() for c in repository):
        raise ValueError("invalid booted image reference")
    return reference, digest, repository + "@" + digest


def sync_directory(path: Path) -> None:
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


@contextmanager
def scratch_directory():
    path = Path("/var/tmp/cubelinux-recovery-update")
    marker = path / ".cubelinux-recovery-update"
    if path.is_symlink():
        raise ValueError("recovery scratch path is a symlink")
    if path.exists():
        if not trusted_scratch(path, marker):
            raise ValueError("refusing to remove unrecognized recovery scratch data")
        shutil.rmtree(path)
    path.mkdir(mode=0o700)
    marker.write_text(SCRATCH_MARKER)
    marker.chmod(0o600)
    try:
        yield path
    finally:
        if trusted_scratch(path, marker):
            shutil.rmtree(path)


def trusted_scratch(path: Path, marker: Path) -> bool:
    """Only remove private, root-owned work created by this updater."""
    try:
        directory_stat = path.lstat()
        marker_stat = marker.lstat()
        return (stat.S_ISDIR(directory_stat.st_mode) and directory_stat.st_uid == 0
                and not directory_stat.st_mode & 0o077
                and stat.S_ISREG(marker_stat.st_mode) and marker_stat.st_uid == 0
                and not marker_stat.st_mode & 0o077
                and marker_stat.st_size == len(SCRATCH_MARKER)
                and marker.read_text() == SCRATCH_MARKER)
    except OSError:
        return False


def image_path(tree: Path, absolute: str) -> Path:
    """Resolve image symlinks inside the extracted root, never on the host."""
    remaining = list(PurePosixPath(absolute).parts[1:])
    resolved: list[str] = []
    followed = 0
    while remaining:
        part = remaining.pop(0)
        if part in ("", "."):
            continue
        if part == "..":
            if not resolved:
                raise ValueError("image path escapes the extracted root")
            resolved.pop()
            continue
        candidate = tree.joinpath(*resolved, part)
        if candidate.is_symlink():
            followed += 1
            if followed > 32:
                raise ValueError("too many image symlinks")
            target = PurePosixPath(os.readlink(candidate))
            if target.is_absolute():
                resolved = []
                remaining = list(target.parts[1:]) + remaining
            else:
                remaining = list(target.parts) + remaining
        else:
            resolved.append(part)
    return tree.joinpath(*resolved)


def activate_slot(mount: Path, slot: str, recovery_id: str) -> None:
    if slot not in ("A", "B") or not re.fullmatch(r"[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}", recovery_id):
        raise ValueError("invalid recovery activation target")
    config = (f"set recovery_slot={slot}\n"
              f"linux ($recovery)/slots/{slot}/boot/vmlinuz root=live:PARTUUID={recovery_id} ro rd.live.image rd.live.dir=/slots/{slot}/LiveOS rd.live.overlay.overlayfs=1 cubelinux.recovery=1 cubelinux.recovery_slot={slot} console=tty0\n"
              f"initrd ($recovery)/slots/{slot}/boot/initrd.img\nboot\n")
    replacement = mount / ".active.cfg.new"
    with replacement.open("w") as output:
        output.write(config)
        output.flush()
        os.fsync(output.fileno())
    os.replace(replacement, mount / "active.cfg")
    sync_directory(mount)


def update(mount: Path, layout: dict[str, str], current: str, reference: str, digest: str, source: str,
           component_root: Path = Path("/usr/lib/cubelinux-recovery")) -> None:
    current_dir = mount / "slots" / current
    digest_file = current_dir / "CUBELINUX_DIGEST"
    if digest_file.is_file() and digest_file.read_text().strip() == digest:
        print("Recovery already matches the booted image.")
        return
    inactive = "B" if current == "A" else "A"
    slots = mount / "slots"
    destination = slots / inactive
    staged = slots / (".staging-" + inactive)
    if staged.is_symlink() or destination.is_symlink():
        raise ValueError("invalid recovery slot path")
    # The active slot is never removed; interrupted staging is safe to retry.
    if staged.exists():
        shutil.rmtree(staged)
    if destination.exists():
        shutil.rmtree(destination)
    staged.mkdir(mode=0o755)

    with scratch_directory() as work:
        old_squash = current_dir / "LiveOS/squashfs.img"
        if shutil.disk_usage(work).free < old_squash.stat().st_size * 3 + 10 * 1024**3:
            raise ValueError("insufficient temporary disk space to rebuild recovery")
        archive = work / "payload.oci.tar"
        args = ["/usr/bin/skopeo", "copy", "--preserve-digests"]
        if Path("/etc/ostree/auth.json").is_file():
            args += ["--src-authfile", "/etc/ostree/auth.json"]
        command(*args, "docker://" + source, "oci-archive:" + str(archive) + ":localhost/cubelinux-offline:payload")
        tree = work / "root"
        command("/usr/bin/unsquashfs", "-no-progress", "-d", str(tree), str(old_squash))
        payload = image_path(tree, "/usr/share/cubelinux/payload.oci.tar")
        reference_file = image_path(tree, "/usr/share/cubelinux/target-image-ref")
        app = image_path(tree, "/usr/lib/cubelinux-recovery")
        runtime = image_path(tree, "/usr/local/libexec/cubelinux")
        if not payload.is_file() or not reference_file.is_file() or not app.is_dir():
            raise ValueError("the recovery image has an unsupported filesystem layout")
        # Preserve the existing file's SELinux label inside the live image.
        shutil.copyfile(archive, payload)
        reference_file.write_text(reference + "\n")
        shutil.copytree(component_root, app, dirs_exist_ok=True)
        if not runtime.is_dir():
            raise ValueError("the recovery runtime directory is missing")
        for name in ("install-bootc", "cleanup-installed-fstab", "verify-recovery-bundle",
                     "check-recovery-layout", "factory-reset", "install-recovery-boot"):
            source_helper = component_root / "runtime" / name
            destination_helper = runtime / name
            if not source_helper.is_file() or destination_helper.is_symlink():
                raise ValueError(f"invalid recovery runtime helper: {name}")
            shutil.copyfile(source_helper, destination_helper)
            destination_helper.chmod(0o755)
        ui_binary = component_root / "recovery-ui"
        if not ui_binary.is_file() or (runtime / "recovery-ui").is_symlink():
            raise ValueError("the compiled recovery interface is missing")
        shutil.copyfile(ui_binary, runtime / "recovery-ui")
        (runtime / "recovery-ui").chmod(0o755)
        # The new UI is built with the updated OS. Check it against the
        # recovery environment before switching, since its Qt may be older.
        ui_environment = os.environ.copy()
        ui_environment.update({"QT_QPA_PLATFORM": "offscreen", "QT_QUICK_BACKEND": "software"})
        subprocess.run(["/usr/sbin/chroot", str(tree), "/usr/local/libexec/cubelinux/recovery-ui", "--check-qml"],
                       env=ui_environment, check=True, timeout=60)
        (staged / "LiveOS").mkdir()
        (staged / "boot").mkdir()
        new_squash = work / "squashfs.img"
        command("/usr/bin/mksquashfs", str(tree), str(new_squash),
                "-noappend", "-no-progress", "-comp", "xz")
        boot_bytes = sum((current_dir / "boot" / name).stat().st_size for name in ("vmlinuz", "initrd.img"))
        if new_squash.stat().st_size + boot_bytes > MAX_BUNDLE:
            raise ValueError("new recovery bundle exceeds the slot size limit")
        if shutil.disk_usage(mount).free < new_squash.stat().st_size + boot_bytes + 1024**3:
            raise ValueError("insufficient free space on the recovery partition")
        shutil.copyfile(new_squash, staged / "LiveOS/squashfs.img")
        for name in ("vmlinuz", "initrd.img"):
            shutil.copyfile(current_dir / "boot" / name, staged / "boot" / name)
        shutil.copyfile(current_dir / "CUBELINUX_LAYOUT", staged / "CUBELINUX_LAYOUT")
        (staged / "CUBELINUX_IMAGE_REF").write_text(reference + "\n")
        (staged / "CUBELINUX_DIGEST").write_text(digest + "\n")
        names = (*REQUIRED_FILES, "CUBELINUX_DIGEST")
        if sum((staged / name).stat().st_size for name in names) > MAX_BUNDLE:
            raise ValueError("new recovery bundle exceeds the slot size limit")
        (staged / "SHA256SUMS").write_text("".join(f"{sha256(staged / name)}  {name}\n" for name in names))
        verify_slot(staged)
        command("/usr/bin/sync", "--file-system", str(mount))
        os.rename(staged, destination)
        sync_directory(slots)
        activate_slot(mount, inactive, layout["recovery_partuuid"])
        print("Recovery updated to the booted cubelinux image.")


def main() -> int:
    if os.geteuid() != 0 or len(sys.argv) != 1:
        raise ValueError("recovery updates require root")
    with open("/run/cubelinux-recovery-update.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        root = command("/usr/bin/findmnt", "-nro", "SOURCE", "--mountpoint", "/sysroot").split("[", 1)[0]
        root_part, root_disk = device_info(root)
        root_id = block_id(root_part, "PARTUUID")
        disk_id = block_id(root_disk, "PTUUID")
        efi = command("/usr/bin/findmnt", "-nro", "SOURCE", "--mountpoint", "/boot/efi")
        efi_id = block_id(efi, "PARTUUID")
        reference, digest, image = booted_image()
        result = subprocess.run(["/usr/sbin/blkid", "-t", "PARTLABEL=CUBE_RECOVERY", "-o", "device"],
                                text=True, stdout=subprocess.PIPE, check=False)
        with tempfile.TemporaryDirectory(prefix="cubelinux-recovery-mount-", dir="/run") as directory:
            mount = Path(directory)
            matches = []
            for candidate in result.stdout.splitlines():
                if device_info(candidate)[1] != root_disk:
                    continue
                mounted = subprocess.run(["/usr/bin/findmnt", "--noheadings", "--source", candidate],
                                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
                if mounted.returncode == 0:
                    raise ValueError("recovery partition is already mounted")
                if mounted.returncode != 1:
                    raise ValueError("could not determine whether recovery is mounted")
                command("/usr/bin/mount", "-o", "ro,nodev,nosuid,noexec", candidate, str(mount))
                try:
                    slot = active_slot(mount)
                    layout = verify_slot(mount / "slots" / slot)
                    if (layout["root_partuuid"].lower() == root_id.lower()
                            and layout["disk_ptuuid"].lower() == disk_id.lower()
                            and layout["efi_partuuid"].lower() == efi_id.lower()
                            and layout["recovery_partuuid"].lower() == block_id(candidate, "PARTUUID").lower()):
                        matches.append(candidate)
                finally:
                    command("/usr/bin/umount", str(mount))
            if not matches:
                print("No recovery partition for this installation; skipping.")
                return 0
            if len(matches) != 1:
                raise ValueError("multiple recovery partitions match this system")
            command("/usr/bin/mount", "-o", "rw,nodev,nosuid,noexec", matches[0], str(mount))
            try:
                slot = active_slot(mount)
                layout = verify_slot(mount / "slots" / slot)
                update(mount, layout, slot, reference, digest, image)
            finally:
                command("/usr/bin/umount", str(mount))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError, KeyError, TypeError, subprocess.SubprocessError) as error:
        print(f"Recovery update failed: {error}", file=sys.stderr)
        sys.exit(1)
