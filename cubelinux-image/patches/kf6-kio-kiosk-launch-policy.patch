diff --git a/src/gui/kioskdesktopfile_p.h b/src/gui/kioskdesktopfile_p.h
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/src/gui/kioskdesktopfile_p.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QStandardPaths>
+#include <QString>
+
+namespace KIO
+{
+namespace detail
+{
+inline bool isTrustedSystemApplicationEntry(const QString &path)
+{
+    const QString realPath = QFileInfo(path).canonicalFilePath();
+    if (realPath.isEmpty() || QFileInfo(realPath).suffix() != QStringLiteral("desktop")) {
+        return false;
+    }
+
+    bool inSystemApplicationsDirectory = false;
+    for (const QString &location : QStandardPaths::standardLocations(QStandardPaths::ApplicationsLocation)) {
+        const QString realLocation = QFileInfo(location).canonicalFilePath();
+        if (!realLocation.isEmpty() && realPath.startsWith(realLocation + QDir::separator())) {
+            inSystemApplicationsDirectory = true;
+            break;
+        }
+    }
+    if (!inSystemApplicationsDirectory) {
+        return false;
+    }
+
+    const QFile::Permissions writableByOthers = QFile::WriteGroup | QFile::WriteOther;
+    const QFileInfo entryInfo(realPath);
+    if (!entryInfo.isFile() || entryInfo.ownerId() != 0
+        || (entryInfo.permissions() & writableByOthers) != QFile::Permissions{}) {
+        return false;
+    }
+
+    QString directory = entryInfo.absolutePath();
+    while (true) {
+        const QFileInfo directoryInfo(directory);
+        if (!directoryInfo.isDir() || directoryInfo.ownerId() != 0
+            || (directoryInfo.permissions() & writableByOthers) != QFile::Permissions{}) {
+            return false;
+        }
+        const QString parent = QDir::cleanPath(QDir(directory).absoluteFilePath(QStringLiteral("..")));
+        if (parent == directory) {
+            break;
+        }
+        directory = parent;
+    }
+    return true;
+}
+}
+}
