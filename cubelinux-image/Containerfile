# syntax=docker/dockerfile:1
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44
FROM ${BASE_IMAGE} AS packages

ARG PACKAGES

RUN dnf -y install \
        --exclude='plasma-discover-packagekit*' \
        --exclude='plasma-discover-rpm-ostree*' \
        --exclude='plasma-discover-snap*' \
        --exclude='plasma-discover-kns*' \
        --exclude='plasma-discover-offline-updates*' \
        --exclude=PackageKit \
        ${PACKAGES} && \
    dnf clean all

FROM packages AS kio-build

COPY patches/kf6-kio-kiosk-launch-policy.patch /tmp/kf6-kio-kiosk-launch-policy.patch
COPY scripts/build_patched_kio.py /tmp/build_patched_kio.py
RUN python3 /tmp/build_patched_kio.py \
        /tmp/kf6-kio-kiosk-launch-policy.patch \
        /tmp/patched-kio-rpms && \
    rm -f /tmp/build_patched_kio.py /tmp/kf6-kio-kiosk-launch-policy.patch

# Compile the recovery application, KDE Settings module, and backend helpers in
# a separate stage so development dependencies stay out of the system image.
FROM packages AS recovery-build
RUN dnf -y install cmake gcc-c++ extra-cmake-modules \
        qt6-qtbase-devel qt6-qtdeclarative-devel \
        kf6-kcoreaddons-devel kf6-kcmutils-devel kf6-ki18n-devel && \
    dnf clean all
COPY .image-build/rootfs/ /tmp/component-root/
RUN mkdir -p /tmp/recovery-artifacts && \
    if [ -d /tmp/component-root/usr/share/cubelinux-recovery/backend-src ]; then \
        cmake -S /tmp/component-root/usr/share/cubelinux-recovery/backend-src -B /tmp/recovery-backend-build \
            -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release && \
        cmake --build /tmp/recovery-backend-build --parallel && \
        DESTDIR=/tmp/recovery-artifacts cmake --install /tmp/recovery-backend-build; \
    fi && \
    if [ -d /tmp/component-root/usr/share/cubelinux-recovery/kcm-src ]; then \
        cmake -S /tmp/component-root/usr/share/cubelinux-recovery/kcm-src -B /tmp/kcm-build \
            -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_BUILD_TYPE=Release && \
        cmake --build /tmp/kcm-build --parallel && \
        DESTDIR=/tmp/recovery-artifacts cmake --install /tmp/kcm-build && \
        cmake -S /tmp/component-root/usr/lib/cubelinux-recovery/native -B /tmp/recovery-ui-build \
            -DCMAKE_BUILD_TYPE=Release && \
        cmake --build /tmp/recovery-ui-build --parallel && \
        install -D -m 0755 /tmp/recovery-ui-build/cubelinux-recovery \
            /tmp/recovery-artifacts/usr/lib/cubelinux-recovery/recovery-ui; \
    fi

FROM packages AS final

COPY --from=kio-build /tmp/patched-kio-rpms/ /tmp/patched-kio-rpms/
RUN rpm -Uvh /tmp/patched-kio-rpms/*.rpm && \
    rm -rf /tmp/patched-kio-rpms

COPY .image-build/distro.json /tmp/distro.json
COPY scripts/configure_distro.py /tmp/configure_distro.py
RUN python3 /tmp/configure_distro.py /tmp/distro.json && \
    rm -f /tmp/configure_distro.py /tmp/distro.json

# Plymouth must be present in the initramfs, which is shipped with the bootc image.
RUN set -eux; \
    kver="$(ls /usr/lib/modules)"; \
    env DRACUT_NO_XATTR=1 dracut -vf "/usr/lib/modules/${kver}/initramfs.img" "${kver}"; \
    bootc container lint

COPY .image-build/rootfs/ /
COPY --from=recovery-build /tmp/recovery-artifacts/ /
RUN if [ -d /usr/share/cubelinux-recovery/kcm-src ]; then \
        test -x /usr/lib/cubelinux-recovery/recovery-ui && \
        plugin="$(find /usr/lib64 /usr/lib -type f -name '*kcm_cubelinux_recovery*.so' -print -quit)" && \
        test -n "$plugin" && \
        ldd -r "$plugin" > /tmp/recovery-kcm-ldd && \
        ! grep -E 'not found|undefined symbol' /tmp/recovery-kcm-ldd && \
        ldd /usr/lib/cubelinux-recovery/recovery-ui > /tmp/recovery-ui-ldd && \
        ! grep -q 'not found' /tmp/recovery-ui-ldd && \
        rm -f /tmp/recovery-kcm-ldd /tmp/recovery-ui-ldd; \
    fi && \
    if [ -d /usr/share/cubelinux-recovery/backend-src ]; then \
        test -x /usr/libexec/cubelinux-recovery-update && \
        test -x /usr/libexec/cubelinux-recovery-reboot && \
        ldd /usr/libexec/cubelinux-recovery-update > /tmp/recovery-update-ldd && \
        ldd /usr/libexec/cubelinux-recovery-reboot > /tmp/recovery-reboot-ldd && \
        ! grep -q 'not found' /tmp/recovery-update-ldd && \
        ! grep -q 'not found' /tmp/recovery-reboot-ldd && \
        rm -f /tmp/recovery-update-ldd /tmp/recovery-reboot-ldd; \
    fi

# Reserve a trusted KDE applications subdirectory backed by writable /var.
RUN install -d -o root -g root -m 0755 /usr/local/share/applications/cubelinux

# Add the cubelinux widget defaults to the Breeze theme package in the image.
COPY config/plasma/plasmoidsetupscripts/ \
    /usr/share/plasma/look-and-feel/org.kde.breeze.desktop/contents/plasmoidsetupscripts/
COPY config/plasma/kdeglobals /tmp/cubelinux-kdeglobals
COPY scripts/configure_plasma.py /tmp/configure_plasma.py
RUN python3 /tmp/configure_plasma.py && \
    rm -f /tmp/cubelinux-kdeglobals /tmp/configure_plasma.py

COPY config/sddm-theme.conf /etc/sddm.conf.d/10-theme.conf
COPY --chmod=0755 config/plasma/plasma-setup-hide-edit-mode \
    /usr/libexec/cubelinux-plasma-setup-hide-edit-mode
COPY config/plasma/plasma-setup-hide-edit-mode.service \
    /usr/lib/systemd/user/cubelinux-plasma-setup-hide-edit-mode.service
RUN mkdir -p /usr/lib/systemd/user/default.target.wants && \
    ln -s ../cubelinux-plasma-setup-hide-edit-mode.service \
        /usr/lib/systemd/user/default.target.wants/cubelinux-plasma-setup-hide-edit-mode.service
COPY bootc/kargs.d/10-quiet-boot.toml /usr/lib/bootc/kargs.d/10-quiet-boot.toml
COPY .image-build/services.txt /tmp/component-services.txt
RUN firewall-offline-cmd --policy-desktop && \
    systemctl --root=/ enable NetworkManager.service firewalld.service && \
    systemctl --root=/ enable --force sddm.service && \
    systemctl --root=/ enable plasma-setup.service && \
    while IFS= read -r service; do \
        [ -z "$service" ] || systemctl --root=/ enable "$service"; \
    done < /tmp/component-services.txt && \
    systemctl --root=/ set-default graphical.target && \
    rm -f /tmp/component-services.txt

# Verify the completed filesystem before BuildKit exports or publishes it.
RUN --mount=type=bind,source=.image-build,target=/tmp/cubelinux-image-build,ro \
    --mount=type=bind,source=scripts,target=/tmp/cubelinux-image-scripts,ro \
    --mount=type=bind,source=config,target=/tmp/config,ro \
    python3 /tmp/cubelinux-image-scripts/verify_image.py \
        --rootfs / \
        --distro /tmp/cubelinux-image-build/distro.json \
        --expected-rootfs /tmp/cubelinux-image-build/rootfs
