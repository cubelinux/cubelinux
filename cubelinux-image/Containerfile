# syntax=docker/dockerfile:1
ARG BASE_IMAGE=quay.io/fedora/fedora-bootc:44
ARG VSHELL_RUNTIME_IMAGE=ghcr.io/cubelinux/cubelinux-vshell-runtime:main

FROM ${BASE_IMAGE} AS packages

ARG PACKAGES

RUN dnf -y install \
        --exclude='plasma-discover-packagekit*' \
        --exclude='plasma-discover-rpm-ostree*' \
        --exclude='plasma-discover-snap*' \
        --exclude='plasma-discover-kns*' \
        --exclude='plasma-discover-offline-updates*' \
        --exclude=PackageKit \
        ${PACKAGES} && \
    dnf clean all

# Keep a local OCI layout for first-login setup, which must work offline.
FROM packages AS vshell-runtime-bundle
ARG VSHELL_RUNTIME_IMAGE
ARG VSHELL_RUNTIME_CACHE_KEY=local
RUN test -n "${VSHELL_RUNTIME_CACHE_KEY}" && \
    mkdir -p /usr/lib/cubelinux-vshell && \
    skopeo copy "docker://${VSHELL_RUNTIME_IMAGE}" \
        oci:/usr/lib/cubelinux-vshell/runtime-oci:main

FROM packages AS kio-build

COPY patches/kf6-kio-kiosk-launch-policy.patch /tmp/kf6-kio-kiosk-launch-policy.patch
COPY scripts/build_patched_kio.py /tmp/build_patched_kio.py
RUN python3 /tmp/build_patched_kio.py \
        /tmp/kf6-kio-kiosk-launch-policy.patch \
        /tmp/patched-kio-rpms && \
    rm -f /tmp/build_patched_kio.py /tmp/kf6-kio-kiosk-launch-policy.patch

FROM packages AS final

COPY --from=kio-build /tmp/patched-kio-rpms/ /tmp/patched-kio-rpms/
RUN rpm -Uvh /tmp/patched-kio-rpms/*.rpm && \
    rm -rf /tmp/patched-kio-rpms

COPY .image-build/distro.json /tmp/distro.json
COPY scripts/configure_distro.py /tmp/configure_distro.py
RUN python3 /tmp/configure_distro.py /tmp/distro.json && \
    rm -f /tmp/configure_distro.py /tmp/distro.json

# Plymouth must be present in the initramfs, which is shipped with the bootc image.
RUN set -eux; \
    kver="$(ls /usr/lib/modules)"; \
    env DRACUT_NO_XATTR=1 dracut -vf "/usr/lib/modules/${kver}/initramfs.img" "${kver}"; \
    bootc container lint

COPY .image-build/rootfs/ /

# Keep the original OCI image layout so first login can initialize VShell offline.
COPY --from=vshell-runtime-bundle \
    /usr/lib/cubelinux-vshell/runtime-oci/ \
    /usr/lib/cubelinux-vshell/runtime-oci/

# Add the cubelinux widget defaults to the Breeze theme package in the image.
COPY config/plasma/plasmoidsetupscripts/ \
    /usr/share/plasma/look-and-feel/org.kde.breeze.desktop/contents/plasmoidsetupscripts/
COPY config/plasma/kdeglobals /tmp/cubelinux-kdeglobals
COPY scripts/configure_plasma.py /tmp/configure_plasma.py
RUN python3 /tmp/configure_plasma.py && \
    rm -f /tmp/cubelinux-kdeglobals /tmp/configure_plasma.py

COPY config/sddm-theme.conf /etc/sddm.conf.d/10-theme.conf
COPY bootc/kargs.d/10-quiet-boot.toml /usr/lib/bootc/kargs.d/10-quiet-boot.toml
COPY .image-build/services.txt /tmp/component-services.txt
RUN systemctl --root=/ enable NetworkManager.service firewalld.service && \
    systemctl --root=/ enable --force sddm.service && \
    systemctl --root=/ enable plasma-setup.service && \
    while IFS= read -r service; do \
        [ -z "$service" ] || systemctl --root=/ enable "$service"; \
    done < /tmp/component-services.txt && \
    systemctl --root=/ set-default graphical.target && \
    rm -f /tmp/component-services.txt

# Verify the completed filesystem before BuildKit exports or publishes it.
RUN --mount=type=bind,source=.image-build,target=/tmp/cubelinux-image-build,ro \
    --mount=type=bind,source=scripts,target=/tmp/cubelinux-image-scripts,ro \
    --mount=type=bind,source=config,target=/tmp/config,ro \
    python3 /tmp/cubelinux-image-scripts/verify_image.py \
        --rootfs / \
        --distro /tmp/cubelinux-image-build/distro.json \
        --expected-rootfs /tmp/cubelinux-image-build/rootfs
