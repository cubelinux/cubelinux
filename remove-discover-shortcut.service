[Unit]
Description=Remove Discover from saved Plasma taskbar launchers
DefaultDependencies=no
After=local-fs.target
Before=display-manager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/find /home /root -type f -path '*/.config/plasma-org.kde.plasma.desktop-appletsrc' -exec /usr/bin/sed -i -E -e "s/[\"']?(applications:)?org\\.kde\\.discover\\.desktop[\"']?,[[:space:]]*//g" -e "s/,[[:space:]]*[\"']?(applications:)?org\\.kde\\.discover\\.desktop[\"']?//g" -e 's/(applications:)?org\.kde\.discover\.desktop//g' {} +
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
